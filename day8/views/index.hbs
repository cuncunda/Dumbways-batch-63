<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Identitas Diri</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap"
      rel="stylesheet"
    />
    <style>
      * { font-family: "Nunito Sans", sans-serif; }
    </style>
  </head>
  <body
    class="d-flex justify-content-center align-items-center"
    style="height: 100vh; background-color: #ffffff;"
  >

    <div
      class="card p-4 shadow-lg"
      style="width: 400px; border-radius: 12px; background-color: #ffffff"
    >
      <h2 class="text-center mb-4">Identitas Diri</h2>

      <p><strong>Nama:</strong> {{nama}}</p>
      <p><strong>Umur:</strong> {{umur}}</p>

      <p><strong>Hobi:</strong></p>
      <ul>
        {{#each hobi}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>

  </body>
</html>